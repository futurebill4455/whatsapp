<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= businessName %></title>
  <%- include('partials/styles') %>
</head>
<body class="font-sans text-ink page-bg min-h-screen antialiased">
  <header class="border-b border-ink/10 bg-white/70 backdrop-blur">
    <div class="max-w-lg mx-auto px-4 h-14 flex items-center">
      <span class="font-display text-lg font-semibold bg-gradient-to-r from-sea to-violet bg-clip-text text-transparent"><%= businessName %></span>
    </div>
  </header>

  <main class="max-w-lg mx-auto px-4 py-10 animate-in">
    <h1 class="font-display text-3xl font-semibold mb-2">Insurance enquiry</h1>
    <p class="text-ink/65 mb-8"><%= formIntro %></p>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="mb-6 rounded-2xl px-4 py-3 text-sm font-medium border <%= flash.type === 'error' ? 'bg-coral/10 text-coral border-coral/20' : 'bg-sea/10 text-sea border-sea/20' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <form method="post" action="/form/<%= submission.token %>" id="leadForm" class="space-y-6">
      <!-- Step indicators -->
      <div class="flex gap-2 mb-2" id="stepDots">
        <% for (let i = 1; i <= 4; i++) { %>
          <div class="step-dot h-1.5 flex-1 rounded-full bg-ink/10" data-step="<%= i %>"></div>
        <% } %>
      </div>

      <!-- Step 1: Type -->
      <section class="panel p-5 form-step" data-step="1">
        <h2 class="font-display font-semibold mb-3">1. Insurance type</h2>
        <div class="grid gap-2">
          <% insuranceTypes.forEach(function (t) { %>
            <label class="flex items-center gap-3 rounded-xl border border-ink/10 px-4 py-3 cursor-pointer hover:border-sea/40 has-[:checked]:border-sea has-[:checked]:bg-sea/5">
              <input type="radio" name="insurance_type" value="<%= t.name %>" required class="accent-sea" />
              <span class="font-semibold"><%= t.name %></span>
            </label>
          <% }) %>
        </div>
        <button type="button" class="btn-primary mt-5 next-step">Continue</button>
      </section>

      <!-- Step 2: Company -->
      <section class="panel p-5 form-step hidden" data-step="2">
        <h2 class="font-display font-semibold mb-3">2. Company</h2>
        <div class="grid gap-2" id="companyList">
          <% companies.forEach(function (c) { %>
            <label class="company-opt flex items-center gap-3 rounded-xl border border-ink/10 px-4 py-3 cursor-pointer hover:border-violet/40 has-[:checked]:border-violet has-[:checked]:bg-violet/5"
                   data-type-id="<%= c.insurance_type_id || '' %>"
                   data-type-name="<%= c.insurance_type_name || '' %>">
              <input type="radio" name="company" value="<%= c.name %>" class="accent-violet" />
              <span class="font-semibold"><%= c.name %></span>
            </label>
          <% }) %>
        </div>
        <div class="flex gap-2 mt-5">
          <button type="button" class="btn-ghost prev-step">Back</button>
          <button type="button" class="btn-primary next-step">Continue</button>
        </div>
      </section>

      <!-- Step 3: Type-specific cover / vehicle / life fields -->
      <section class="panel p-5 form-step hidden" data-step="3">
        <h2 class="font-display font-semibold mb-3" id="step3Title">3. Cover & duration</h2>

        <!-- Health (unchanged) -->
        <div id="healthCover" class="space-y-4">
          <div>
            <label class="label">Sum insured / premium</label>
            <select class="field" name="premium_amount" id="premiumAmount">
              <option value="">Select…</option>
              <% premiums.forEach(function (p) { %>
                <option value="<%= p.value %>"><%= p.label %></option>
              <% }) %>
            </select>
          </div>
          <div>
            <label class="label">Policy duration</label>
            <select class="field" name="policy_duration" id="policyDuration">
              <option value="">Select…</option>
              <% durations.forEach(function (d) { %>
                <option value="<%= d.value %>"><%= d.label %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <!-- Vehicle add-on -->
        <div id="vehicleFields" class="hidden space-y-4">
          <div>
            <label class="label">Vehicle number</label>
            <input class="field" name="vehicle_number" id="vehicleNumber"
                   placeholder="e.g. MH12AB1234" autocomplete="off" />
          </div>
          <div>
            <label class="label">Policy type</label>
            <div class="grid gap-2 mt-1">
              <% ['Full Cover', 'Third Party', 'Bumper to Bumper'].forEach(function (pt) { %>
                <label class="flex items-center gap-3 rounded-xl border border-ink/10 px-4 py-3 cursor-pointer hover:border-sea/40 has-[:checked]:border-sea has-[:checked]:bg-sea/5">
                  <input type="radio" name="policy_type" value="<%= pt %>" class="accent-sea vehicle-policy-type" />
                  <span class="font-semibold"><%= pt %></span>
                </label>
              <% }) %>
            </div>
          </div>
          <p class="text-sm text-ink/55">Insurance company was selected in the previous step.</p>
        </div>

        <!-- Life add-on -->
        <div id="lifeFields" class="hidden space-y-4">
          <div>
            <label class="label">Date of birth</label>
            <input class="field dob-input" type="text" name="date_of_birth" id="lifeDob"
                   inputmode="numeric" placeholder="DD/MM/YYYY" autocomplete="bday" maxlength="10"
                   pattern="\d{1,2}[/\-.]\d{1,2}[/\-.]\d{2,4}" title="Type date as DD/MM/YYYY" />
          </div>
          <div>
            <label class="label">Plan name</label>
            <input class="field" name="plan_name" id="planName" placeholder="e.g. Term Protect" />
          </div>
          <div>
            <label class="label">Yearly premium amount</label>
            <input class="field" name="yearly_premium_amount" id="yearlyPremium"
                   placeholder="e.g. ₹25,000" inputmode="decimal" />
          </div>
        </div>

        <div class="flex gap-2 mt-5">
          <button type="button" class="btn-ghost prev-step">Back</button>
          <button type="button" class="btn-primary next-step">Continue</button>
        </div>
      </section>

      <!-- Step 4: Details -->
      <section class="panel p-5 form-step hidden" data-step="4">
        <h2 class="font-display font-semibold mb-3">4. Your details</h2>
        <div class="space-y-4">
          <div>
            <label class="label" id="customerNameLabel">Full name / Customer name</label>
            <input class="field" name="customer_name" required />
          </div>
          <div id="advisorWrap">
            <label class="label">Advisor name (optional)</label>
            <input class="field" name="advisor_name" />
          </div>
          <!-- Health members — unchanged structure -->
          <div id="healthMembers" class="hidden space-y-3">
            <div>
              <label class="label">Number of members</label>
              <input class="field" type="number" name="member_count" id="memberCount" min="1" max="10" value="1" />
            </div>
            <div id="membersWrap" class="space-y-3"></div>
          </div>
        </div>
        <div class="flex gap-2 mt-5">
          <button type="button" class="btn-ghost prev-step">Back</button>
          <button type="submit" class="btn-primary">Submit enquiry</button>
        </div>
      </section>
    </form>
  </main>

  <script>
    (function () {
      const typeMap = {};
      <% insuranceTypes.forEach(function (t) { %>
        typeMap[<%- JSON.stringify(t.name) %>] = <%- JSON.stringify(String(t.id)) %>;
      <% }) %>

      let step = 1;
      const steps = Array.from(document.querySelectorAll('.form-step'));
      const dots = Array.from(document.querySelectorAll('.step-dot'));
      const premiumEl = document.getElementById('premiumAmount');
      const durationEl = document.getElementById('policyDuration');
      const vehicleNumberEl = document.getElementById('vehicleNumber');
      const lifeDobEl = document.getElementById('lifeDob');
      const planNameEl = document.getElementById('planName');
      const yearlyPremiumEl = document.getElementById('yearlyPremium');

      function showStep(n) {
        step = n;
        steps.forEach(function (s) {
          s.classList.toggle('hidden', Number(s.dataset.step) !== n);
        });
        dots.forEach(function (d) {
          const sn = Number(d.dataset.step);
          d.className =
            'step-dot h-1.5 flex-1 rounded-full ' +
            (sn < n ? 'bg-sea' : sn === n ? 'bg-gradient-to-r from-sea to-violet' : 'bg-ink/10');
        });
      }

      function selectedType() {
        const el = document.querySelector('input[name="insurance_type"]:checked');
        return el ? el.value : '';
      }

      function isHealth() {
        return /health/i.test(selectedType());
      }
      function isVehicle() {
        return /vehicle|motor/i.test(selectedType());
      }
      function isLife() {
        return /life/i.test(selectedType());
      }

      function filterCompanies() {
        const typeName = selectedType();
        const typeId = typeMap[typeName] || '';
        document.querySelectorAll('.company-opt').forEach(function (lab) {
          const tid = lab.getAttribute('data-type-id') || '';
          const tname = (lab.getAttribute('data-type-name') || '').toLowerCase();
          const match =
            !tid ||
            tid === typeId ||
            (typeName && tname === typeName.toLowerCase());
          lab.classList.toggle('hidden', !match);
          if (!match) {
            const radio = lab.querySelector('input');
            if (radio) radio.checked = false;
          }
        });
      }

      /** Show the correct step-3 / step-4 blocks for the selected insurance type. */
      function applyTypeUi() {
        const health = isHealth();
        const vehicle = isVehicle();
        const life = isLife();

        document.getElementById('healthCover').classList.toggle('hidden', !health);
        document.getElementById('vehicleFields').classList.toggle('hidden', !vehicle);
        document.getElementById('lifeFields').classList.toggle('hidden', !life);
        document.getElementById('healthMembers').classList.toggle('hidden', !health);

        const title = document.getElementById('step3Title');
        if (title) {
          title.textContent = health
            ? '3. Cover & duration'
            : vehicle
              ? '3. Vehicle details'
              : life
                ? '3. Life plan details'
                : '3. Details';
        }

        // Required attrs — only for the active type (Health structure unchanged when selected)
        if (premiumEl) premiumEl.required = health;
        if (durationEl) durationEl.required = health;
        if (vehicleNumberEl) vehicleNumberEl.required = vehicle;
        document.querySelectorAll('.vehicle-policy-type').forEach(function (r) {
          r.required = vehicle;
        });
        if (lifeDobEl) lifeDobEl.required = life;
        if (planNameEl) planNameEl.required = life;
        if (yearlyPremiumEl) yearlyPremiumEl.required = life;

        if (health) renderMembers();
      }

      function renderMembers() {
        const wrap = document.getElementById('membersWrap');
        const count = Math.max(1, Math.min(10, Number(document.getElementById('memberCount').value) || 1));
        wrap.innerHTML = '';
        for (let i = 1; i <= count; i++) {
          const box = document.createElement('div');
          box.className = 'rounded-xl border border-ink/10 p-3 space-y-2';
          box.innerHTML =
            '<p class="text-xs font-semibold uppercase text-ink/45">Member ' + i + '</p>' +
            '<input class="field" name="member_' + i + '_name" placeholder="Name" ' + (isHealth() ? 'required' : '') + ' />' +
            '<label class="text-xs text-ink/50">Date of birth (type DD/MM/YYYY)</label>' +
            '<input class="field dob-input" type="text" name="member_' + i + '_dob" ' +
            'inputmode="numeric" placeholder="DD/MM/YYYY" autocomplete="bday" maxlength="10" ' +
            (isHealth() ? 'required ' : '') +
            'pattern="\\d{1,2}[/\\-.]\\d{1,2}[/\\-.]\\d{2,4}" title="Type date as DD/MM/YYYY" />' +
            '<select class="field" name="member_' + i + '_gender">' +
            '<option value="">Gender</option><option>Male</option><option>Female</option><option>Other</option></select>';
          wrap.appendChild(box);
        }
        wrap.querySelectorAll('.dob-input').forEach(bindDobTyping);
      }

      /** Allow keyboard typing of DOB; light auto-slash formatting (no calendar popup). */
      function bindDobTyping(input) {
        if (!input || input._dobBound) return;
        input._dobBound = true;
        input.addEventListener('input', function () {
          let v = input.value.replace(/[^\d]/g, '').slice(0, 8);
          if (v.length >= 5) {
            v = v.slice(0, 2) + '/' + v.slice(2, 4) + '/' + v.slice(4);
          } else if (v.length >= 3) {
            v = v.slice(0, 2) + '/' + v.slice(2);
          }
          input.value = v;
        });
      }

      if (lifeDobEl) bindDobTyping(lifeDobEl);

      document.querySelectorAll('.next-step').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (step === 1) {
            if (!selectedType()) return alert('Please select an insurance type.');
            filterCompanies();
            applyTypeUi();
          }
          if (step === 2) {
            if (!document.querySelector('input[name="company"]:checked')) {
              return alert('Please select a company.');
            }
          }
          if (step === 3) {
            if (isHealth()) {
              if (!premiumEl.value || !durationEl.value) {
                return alert('Please select premium and duration.');
              }
            } else if (isVehicle()) {
              if (!String(vehicleNumberEl.value || '').trim()) {
                return alert('Please enter the vehicle number.');
              }
              if (!document.querySelector('input[name="policy_type"]:checked')) {
                return alert('Please select a policy type.');
              }
            } else if (isLife()) {
              if (!String(lifeDobEl.value || '').trim()) {
                return alert('Please enter date of birth (DD/MM/YYYY).');
              }
              if (!String(planNameEl.value || '').trim()) {
                return alert('Please enter the plan name.');
              }
              if (!String(yearlyPremiumEl.value || '').trim()) {
                return alert('Please enter the yearly premium amount.');
              }
            }
          }
          showStep(Math.min(4, step + 1));
        });
      });

      document.querySelectorAll('.prev-step').forEach(function (btn) {
        btn.addEventListener('click', function () {
          showStep(Math.max(1, step - 1));
        });
      });

      document.querySelectorAll('input[name="insurance_type"]').forEach(function (r) {
        r.addEventListener('change', function () {
          filterCompanies();
          applyTypeUi();
        });
      });

      const mc = document.getElementById('memberCount');
      if (mc) mc.addEventListener('change', renderMembers);

      showStep(1);
    })();
  </script>
</body>
</html>
