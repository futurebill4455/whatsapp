<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= businessName %></title>
  <%- include('../partials/styles') %>
</head>
<body class="font-sans text-ink page-bg min-h-screen antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-4 py-8 space-y-6 animate-in">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <a href="/admin/campaigns" class="text-sm font-semibold text-sea hover:underline">← Campaigns</a>
        <h1 class="font-display text-3xl font-bold mt-2 dark:text-white"><%= campaign.name %></h1>
        <p class="text-ink/55 dark:text-slate-400 text-sm mt-1">
          <%= campaign.content_type === 'image_text' ? 'Image + text' : 'Text' %>
          · status <strong id="statusLabel" class="dark:text-white"><%= campaign.status %></strong>
          <% if (campaign.schedule_at) { %> · schedule <%= campaign.schedule_at %><% } %>
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <% if (campaign.status === 'draft' || campaign.status === 'paused' || campaign.status === 'scheduled') { %>
          <form method="post" action="/admin/campaigns/<%= campaign.id %>/start">
            <button class="btn-primary" <%= waReady ? '' : 'disabled' %>>
              <%= campaign.status === 'scheduled' ? 'Arm / Run now' : 'Start / Resume' %>
            </button>
          </form>
        <% } %>
        <% if (campaign.status === 'running') { %>
          <form method="post" action="/admin/campaigns/<%= campaign.id %>/pause">
            <button class="btn-ghost">Pause</button>
          </form>
        <% } %>
        <% if (campaign.status !== 'cancelled' && campaign.status !== 'completed') { %>
          <form method="post" action="/admin/campaigns/<%= campaign.id %>/cancel"
                onsubmit="return confirm('Cancel campaign?');">
            <button class="btn-ghost text-coral border-coral/25">Cancel</button>
          </form>
        <% } %>
        <form method="post" action="/admin/campaigns/<%= campaign.id %>/delete"
              onsubmit="return confirm('Delete campaign permanently?');">
          <button class="btn-ghost text-coral border-coral/25">Delete</button>
        </form>
      </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="rounded-2xl px-4 py-3 text-sm font-medium border <%= flash.type === 'error' ? 'bg-coral/10 text-coral border-coral/20' : 'bg-sea/10 text-sea border-sea/20' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <% const total = Number(stats.total)||0; const sent = Number(stats.sent)||0; const pct = total ? Math.round(sent/total*100) : 0; %>
    <div class="panel p-5">
      <div class="flex justify-between text-sm mb-2 dark:text-slate-300">
        <span>Delivery progress</span>
        <span id="pctLabel"><%= pct %>%</span>
      </div>
      <div class="progress-track h-3"><div id="progressFill" class="progress-fill" style="width:<%= pct %>%"></div></div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-3" id="statsGrid">
      <% [
        { label: 'Total', key: 'total' },
        { label: 'Pending', key: 'pending' },
        { label: 'Sent', key: 'sent' },
        { label: 'Failed', key: 'failed' },
        { label: 'Replied', key: 'replied' },
      ].forEach(function (c) { %>
        <div class="panel p-4 stat-card">
          <div class="text-xs uppercase text-ink/45 dark:text-slate-400 font-semibold"><%= c.label %></div>
          <div class="font-display text-2xl font-semibold mt-1 dark:text-white" data-stat="<%= c.key %>"><%= stats[c.key] || 0 %></div>
        </div>
      <% }) %>
    </div>

    <section class="panel p-5 space-y-3">
      <h2 class="font-display font-semibold dark:text-white">Message sequence</h2>
      <div class="rounded-xl bg-mist/60 dark:bg-white/5 p-4">
        <div class="text-xs font-semibold uppercase text-ink/45 dark:text-slate-400 mb-1">Step 1</div>
        <pre class="text-sm whitespace-pre-wrap dark:text-slate-200"><%= campaign.body_text %></pre>
      </div>
      <% (typeof steps !== 'undefined' ? steps : []).forEach(function (s, i) { %>
        <div class="rounded-xl bg-mist/60 dark:bg-white/5 p-4">
          <div class="text-xs font-semibold uppercase text-ink/45 dark:text-slate-400 mb-1">Step <%= i + 2 %> · delay <%= Math.round(s.delay_min_ms/60000) %>–<%= Math.round(s.delay_max_ms/60000) %> min</div>
          <pre class="text-sm whitespace-pre-wrap dark:text-slate-200"><%= s.body_text %></pre>
        </div>
      <% }) %>
      <p class="text-xs text-ink/45 dark:text-slate-500">
        Base delay <%= Math.round(campaign.delay_min_ms/60000) %>–<%= Math.round(campaign.delay_max_ms/60000) %> min ·
        batch <%= campaign.batch_size %> / <%= Math.round(campaign.batch_window_ms/60000) %> min
        <% if (campaign.next_send_at) { %> · next ~ <%= campaign.next_send_at %><% } %>
      </p>
    </section>

    <section class="panel overflow-hidden">
      <div class="px-4 py-3 border-b border-ink/10 dark:border-white/10 font-semibold dark:text-white">Recipients (live)</div>
      <table class="data-table">
        <thead>
          <tr>
            <th>Phone</th>
            <th>Name</th>
            <th>Status</th>
            <th>Step</th>
            <th>Sent / reply</th>
          </tr>
        </thead>
        <tbody>
          <% recipients.forEach(function (r) { %>
            <tr>
              <td class="font-mono text-xs"><%= r.phone %></td>
              <td><%= r.name || '—' %></td>
              <td><span class="chip bg-mist dark:bg-white/10"><%= r.status %></span></td>
              <td class="text-xs"><%= (r.current_step || 0) + 1 %></td>
              <td class="text-xs text-ink/55 dark:text-slate-400">
                <%= r.sent_at || '—' %>
                <% if (r.reply_text) { %><div class="text-ink/70 dark:text-slate-300"><%= r.reply_text %></div><% } %>
                <% if (r.error) { %><div class="text-coral"><%= r.error %></div><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    (function () {
      const id = <%= campaign.id %>;
      async function refresh() {
        try {
          const res = await fetch('/api/campaigns/' + id + '/stats');
          const data = await res.json();
          if (!data.ok) return;
          document.getElementById('statusLabel').textContent = data.campaign.status;
          ['total','pending','sent','failed','replied'].forEach(function (k) {
            const el = document.querySelector('[data-stat="'+k+'"]');
            if (el) el.textContent = data.stats[k] || 0;
          });
          const total = Number(data.stats.total) || 0;
          const sent = Number(data.stats.sent) || 0;
          const pct = total ? Math.round((sent / total) * 100) : 0;
          const fill = document.getElementById('progressFill');
          const lbl = document.getElementById('pctLabel');
          if (fill) fill.style.width = pct + '%';
          if (lbl) lbl.textContent = pct + '%';
        } catch (_) {}
      }
      setInterval(refresh, 5000);
      try {
        const socket = io();
        socket.on('campaign:update', function (payload) {
          if (payload && payload.campaign && Number(payload.campaign.id) === id) refresh();
        });
      } catch (_) {}
    })();
  </script>
</body>
</html>
