<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= businessName %></title>
  <%- include('../partials/styles') %>
</head>
<body class="font-sans text-ink page-bg min-h-screen antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-3xl mx-auto px-4 py-8 space-y-8 animate-in">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-sea mb-1">Configuration</p>
      <h1 class="font-display text-3xl font-bold">Settings</h1>
      <p class="text-ink/55 mt-1 text-sm">
        Business identity and anti-ban pacing.
        Edit the <a href="/admin/chat-flow" class="text-sea font-semibold hover:underline">common access code &amp; chat messages</a> on Chat Flow.
      </p>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="rounded-2xl px-4 py-3 text-sm font-medium border <%= flash.type === 'error' ? 'bg-coral/10 text-coral border-coral/20' : 'bg-sea/10 text-sea border-sea/20' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <form method="post" action="/admin/settings" class="space-y-6">
      <section class="panel p-5 md:p-6 space-y-4">
        <h2 class="font-display text-lg font-semibold">Business</h2>
        <div>
          <label class="label">Business name</label>
          <input class="field" name="business_name" value="<%= settings.business_name || '' %>" />
        </div>
        <div>
          <label class="label">Close keywords (comma-separated)</label>
          <input class="field" name="close_keywords" value="<%= settings.close_keywords || 'close,cls' %>" />
        </div>
      </section>

      <section class="panel p-5 md:p-6 space-y-4 bg-gradient-to-br from-amber/5 via-white to-sea/5">
        <div class="flex items-center gap-2">
          <span class="chip bg-amber/15 text-amber">Anti-ban</span>
          <h2 class="font-display text-lg font-semibold">Humanization</h2>
        </div>
        <div class="grid sm:grid-cols-2 gap-3">
          <div>
            <label class="label">Typing delay min (ms) — 1000–45000</label>
            <input class="field" type="number" name="anti_ban_jitter_min_ms" min="1000" max="45000"
                   value="<%= settings.anti_ban_jitter_min_ms || 1000 %>" />
          </div>
          <div>
            <label class="label">Typing delay max (ms) — up to 45000 (1–45s)</label>
            <input class="field" type="number" name="anti_ban_jitter_max_ms" min="1000" max="45000"
                   value="<%= settings.anti_ban_jitter_max_ms || 45000 %>" />
          </div>
          <div>
            <label class="label">Min gap between sends (ms)</label>
            <input class="field" type="number" name="anti_ban_min_gap_ms" min="0" max="60000"
                   value="<%= settings.anti_ban_min_gap_ms || 4000 %>" />
          </div>
          <div>
            <label class="label">Timezone</label>
            <input class="field" name="anti_ban_timezone" value="<%= settings.anti_ban_timezone || 'Asia/Kolkata' %>" />
          </div>
          <div>
            <label class="label">Hours start (0–23)</label>
            <input class="field" type="number" name="anti_ban_hours_start" min="0" max="23"
                   value="<%= settings.anti_ban_hours_start || 9 %>" />
          </div>
          <div>
            <label class="label">Hours end (0–23)</label>
            <input class="field" type="number" name="anti_ban_hours_end" min="0" max="23"
                   value="<%= settings.anti_ban_hours_end || 21 %>" />
          </div>
        </div>
        <label class="flex items-center gap-2 text-sm font-semibold">
          <input type="checkbox" name="anti_ban_hours_enabled" value="1"
            <%= String(settings.anti_ban_hours_enabled || '0') === '1' ? 'checked' : '' %> />
          Enforce working hours (currently ignored — bot is 24/7)
        </label>
      </section>

      <section class="panel p-5 md:p-6 space-y-4">
        <div class="flex items-center gap-2">
          <span class="chip bg-sea/15 text-sea">AI</span>
          <h2 class="font-display text-lg font-semibold dark:text-white">Google Gemini plan assistant</h2>
        </div>
        <p class="text-sm text-ink/55 dark:text-slate-400">
          Trigger-only sessions: send the trigger code (default <strong>PLAN</strong>) to start,
          ask plan details by text or voice note, get a Malayalam voice-note reply,
          then send <strong>CLS</strong> (or close) to end. Does not run on every message,
          and never interrupts live desk bridge, access-code unlock, or campaigns.
        </p>
        <label class="flex items-center gap-2 text-sm font-semibold dark:text-slate-300">
          <input type="checkbox" name="gemini_enabled" value="1"
            <%= String(settings.gemini_enabled || '1') !== '0' ? 'checked' : '' %> class="accent-sea" />
          Enable Gemini plan assistant
        </label>
        <div class="grid sm:grid-cols-2 gap-3">
          <div class="sm:col-span-2">
            <label class="label">API key (optional if set in .env)</label>
            <input class="field font-mono text-sm" type="password" name="gemini_api_key"
                   value="<%= settings.gemini_api_key || '' %>"
                   placeholder="AIza…" autocomplete="off" />
          </div>
          <div>
            <label class="label">Trigger code</label>
            <input class="field font-mono uppercase" name="gemini_trigger_code"
                   value="<%= settings.gemini_trigger_code || 'PLAN' %>"
                   placeholder="PLAN" />
          </div>
          <div>
            <label class="label">Chat model</label>
            <input class="field" name="gemini_model"
                   value="<%= settings.gemini_model || 'gemini-2.0-flash' %>" />
          </div>
          <div>
            <label class="label">TTS model</label>
            <input class="field" name="gemini_tts_model"
                   value="<%= settings.gemini_tts_model || 'gemini-2.5-flash-preview-tts' %>" />
          </div>
          <div>
            <label class="label">TTS voice</label>
            <input class="field" name="gemini_tts_voice"
                   value="<%= settings.gemini_tts_voice || 'Kore' %>"
                   placeholder="Kore" />
          </div>
          <div>
            <label class="label">Min gap between AI replies (ms)</label>
            <input class="field" type="number" name="gemini_min_gap_ms" min="500" max="60000"
                   value="<%= settings.gemini_min_gap_ms || 2500 %>" />
          </div>
        </div>
        <div>
          <label class="label">Custom system prompt (optional)</label>
          <textarea class="field min-h-[100px]" name="gemini_system_prompt"
                    placeholder="Leave blank for default Malayalam plan-advisor voice prompt. Use {{business_name}}."><%= settings.gemini_system_prompt || '' %></textarea>
        </div>
      </section>

      <button type="submit" class="btn-primary px-8 py-3">Save settings</button>
    </form>
  </main>
</body>
</html>
