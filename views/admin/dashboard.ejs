<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= businessName %></title>
  <%- include('../partials/styles') %>
</head>
<body class="font-sans text-ink page-bg min-h-screen antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-4 py-8 space-y-8 animate-in">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-violet mb-1">Overview</p>
        <h1 class="font-display text-3xl font-bold dark:text-white">Dashboard</h1>
      </div>
      <div class="flex flex-wrap gap-2">
        <a href="/admin/web-chat" class="btn-ghost">Web Chat</a>
        <a href="/admin/campaigns" class="btn-primary">Campaigns</a>
        <a href="/" class="btn-ghost">QR</a>
      </div>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="rounded-2xl px-4 py-3 text-sm font-medium border <%= flash.type === 'error' ? 'bg-coral/10 text-coral border-coral/20' : 'bg-sea/10 text-sea border-sea/20' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4">
      <% const cards = [
        { label: 'Total leads', value: stats.total, from: 'from-sea', to: 'to-teal-400' },
        { label: 'Today', value: stats.today, from: 'from-amber', to: 'to-orange-400' },
        { label: 'Awaiting form', value: stats.awaiting_form, from: 'from-violet', to: 'to-fuchsia-500' },
        { label: 'Submitted', value: stats.submitted, from: 'from-sky-500', to: 'to-sea' },
        { label: 'Forwarded', value: stats.forwarded, from: 'from-emerald-500', to: 'to-sea' },
        { label: 'Live chats', value: typeof activeChats !== 'undefined' ? activeChats : 0, from: 'from-coral', to: 'to-amber' },
      ]; %>
      <% cards.forEach(function (c) { %>
        <div class="stat-card panel p-4 relative overflow-hidden">
          <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r <%= c.from %> <%= c.to %>"></div>
          <div class="text-xs uppercase tracking-wide text-ink/45 dark:text-slate-400 font-semibold"><%= c.label %></div>
          <div class="font-display text-3xl font-semibold mt-1 dark:text-white"><%= c.value %></div>
        </div>
      <% }) %>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <section class="panel p-5 md:p-6 bg-gradient-to-br from-sea/5 via-white to-violet/5 dark:from-sea/10 dark:via-slate-900 dark:to-violet/10">
        <div class="flex items-center justify-between gap-3 mb-3">
          <h2 class="font-display text-lg font-semibold dark:text-white">Chat flow</h2>
          <a href="/admin/chat-flow" class="text-sm font-semibold text-sea hover:underline">Edit</a>
        </div>
        <p class="text-sm text-ink/55 dark:text-slate-400 mb-4">
          Shared access code for all senders — no Users list, no per-phone codes.
        </p>
        <div class="rounded-xl bg-mist/70 dark:bg-white/5 px-4 py-3 flex flex-wrap items-center justify-between gap-3">
          <div>
            <div class="text-xs uppercase tracking-wide text-ink/45 dark:text-slate-400 font-semibold">Common access code</div>
            <div class="font-mono text-xl font-bold tracking-wider mt-1 dark:text-white"><%= commonAccessCode || 'INSU2026' %></div>
          </div>
          <a href="/admin/chat-flow" class="btn-primary">Configure messages</a>
        </div>
      </section>

      <section class="panel p-5 md:p-6">
        <div class="flex items-center justify-between gap-3 mb-4">
          <h2 class="font-display text-lg font-semibold dark:text-white">WhatsApp</h2>
          <% const st = waStatus && waStatus.status ? waStatus.status : 'unknown'; %>
          <span class="chip <%= waStatus && waStatus.ready ? 'bg-sea/15 text-sea' : (st === 'qr' ? 'bg-amber/15 text-amber' : 'bg-coral/15 text-coral') %>">
            <%= waStatus && waStatus.ready ? 'Ready' : st %>
          </span>
        </div>
        <dl class="grid grid-cols-2 gap-3 text-sm mb-5">
          <div class="rounded-xl bg-mist/60 dark:bg-white/5 p-3">
            <dt class="text-ink/45 dark:text-slate-400 text-xs font-semibold uppercase">Status</dt>
            <dd class="font-semibold mt-0.5 dark:text-white"><%= st %></dd>
          </div>
          <div class="rounded-xl bg-mist/60 dark:bg-white/5 p-3">
            <dt class="text-ink/45 dark:text-slate-400 text-xs font-semibold uppercase">Ready</dt>
            <dd class="font-semibold mt-0.5 dark:text-white"><%= waStatus && waStatus.ready ? 'Yes' : 'No' %></dd>
          </div>
        </dl>
        <% if (waStatus && waStatus.lastError) { %>
          <p class="text-sm text-coral mb-4"><%= waStatus.lastError %></p>
        <% } %>
        <div class="flex flex-wrap gap-2">
          <form method="post" action="/admin/whatsapp/reset-session" onsubmit="return confirm('Reset WhatsApp session and show a new QR?');">
            <button type="submit" class="btn-primary">Reset session</button>
          </form>
          <form method="post" action="/admin/whatsapp/logout" onsubmit="return confirm('Log out of WhatsApp?');">
            <button type="submit" class="btn-ghost text-coral border-coral/25">Logout WA</button>
          </form>
        </div>
      </section>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <section class="panel p-5 md:p-6 lg:col-span-2">
        <h2 class="font-display text-lg font-semibold mb-4 dark:text-white">Active chats</h2>
        <% if (!activeChatList || !activeChatList.length) { %>
          <p class="text-sm text-ink/50 dark:text-slate-500">No live desk bridges right now.</p>
        <% } else { %>
          <ul class="space-y-2 max-h-56 overflow-auto">
            <% activeChatList.forEach(function (c) { %>
              <li class="flex items-center justify-between gap-3 rounded-xl bg-mist/50 dark:bg-white/5 px-3 py-2 text-sm">
                <div>
                  <div class="font-semibold dark:text-white"><%= c.customer_phone %></div>
                  <div class="text-ink/45 dark:text-slate-500 text-xs"><%= c.company_name || 'Desk' %> · #<%= c.session_code || c.id %></div>
                </div>
                <span class="chip bg-sea/15 text-sea">live</span>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <section class="panel p-5 md:p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-display text-lg font-semibold dark:text-white">Recent leads</h2>
          <a href="/admin/submissions" class="text-sm font-semibold text-sea hover:underline">View all</a>
        </div>
        <div class="overflow-x-auto">
          <table class="data-table">
            <thead>
              <tr>
                <th>Customer</th>
                <th>Type</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% (recentLeads || []).forEach(function (l) { %>
                <tr>
                  <td>
                    <div class="font-semibold dark:text-white"><%= l.customer_name || '—' %></div>
                    <div class="text-xs text-ink/45 dark:text-slate-500"><%= l.customer_phone %></div>
                  </td>
                  <td><%= l.insurance_type || '—' %></td>
                  <td><span class="chip bg-violet/10 text-violet"><%= l.status %></span></td>
                </tr>
              <% }) %>
              <% if (!recentLeads || !recentLeads.length) { %>
                <tr><td colspan="3" class="py-6 text-ink/45 dark:text-slate-500">No leads yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="panel p-5 md:p-6">
        <h2 class="font-display text-lg font-semibold mb-4 dark:text-white">Recent messages</h2>
        <ul class="space-y-2 max-h-72 overflow-auto">
          <% (recentMessages || []).forEach(function (m) { %>
            <li class="rounded-xl border border-ink/5 dark:border-white/10 px-3 py-2 text-sm">
              <div class="flex items-center gap-2 mb-1">
                <span class="chip <%= m.direction === 'out' ? 'bg-sea/15 text-sea' : 'bg-amber/15 text-amber' %>"><%= m.direction %></span>
                <span class="text-xs text-ink/45 dark:text-slate-500"><%= m.phone || '—' %></span>
                <span class="text-xs text-ink/35 dark:text-slate-600 ml-auto"><%= m.created_at %></span>
              </div>
              <p class="text-ink/70 dark:text-slate-300 line-clamp-2"><%= m.body %></p>
            </li>
          <% }) %>
          <% if (!recentMessages || !recentMessages.length) { %>
            <li class="text-sm text-ink/45 dark:text-slate-500 py-4">No messages logged yet.</li>
          <% } %>
        </ul>
      </section>
    </div>
  </main>
</body>
</html>
