<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= businessName %></title>
  <%- include('../partials/styles') %>
</head>
<body class="font-sans text-ink page-bg min-h-screen antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-7xl mx-auto px-4 py-8 space-y-8 animate-in">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-amber mb-1">Authorization</p>
      <h1 class="font-display text-3xl font-bold">Access users</h1>
      <p class="text-ink/55 mt-1 text-sm">Name + phone + unique access code. Waiting until the code is verified on WhatsApp.</p>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="rounded-2xl px-4 py-3 text-sm font-medium border <%= flash.type === 'error' ? 'bg-coral/10 text-coral border-coral/20' : 'bg-sea/10 text-sea border-sea/20' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <section class="panel p-5 md:p-6">
      <h2 class="font-display text-lg font-semibold mb-4">Add user</h2>
      <form method="post" action="/admin/access" class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 items-end">
        <div>
          <label class="label">Name</label>
          <input class="field" name="name" required placeholder="Advisor / client name" />
        </div>
        <div>
          <label class="label">Phone</label>
          <input class="field" name="phone" required placeholder="9198XXXXXXXX" />
        </div>
        <div>
          <label class="label">Access code</label>
          <input class="field" name="access_code" required minlength="4" placeholder="INSU2026" />
        </div>
        <button type="submit" class="btn-primary">Add user</button>
      </form>
    </section>

    <section class="panel overflow-hidden">
      <div class="px-5 py-4 border-b border-ink/5 flex items-center justify-between">
        <h2 class="font-display text-lg font-semibold">Users</h2>
        <span class="chip bg-mist text-ink/60"><%= users.length %> total</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-mist/40">
            <tr class="text-left text-xs uppercase tracking-wide text-ink/45">
              <th class="px-4 py-3 font-semibold">Name</th>
              <th class="px-4 py-3 font-semibold">Phone</th>
              <th class="px-4 py-3 font-semibold">Code</th>
              <th class="px-4 py-3 font-semibold">Status</th>
              <th class="px-4 py-3 font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/5">
            <% users.forEach(function (u) {
              const ds = u.display_status || u.status;
              const waiting = ds === 'waiting_code';
            %>
              <tr class="align-top">
                <td class="px-4 py-3 font-semibold"><%= u.name %></td>
                <td class="px-4 py-3"><%= u.phone %></td>
                <td class="px-4 py-3 font-mono text-xs"><%= u.access_code %></td>
                <td class="px-4 py-3">
                  <% if (waiting) { %>
                    <span class="chip bg-amber/15 text-amber">Waiting</span>
                  <% } else if (ds === 'active') { %>
                    <span class="chip bg-sea/15 text-sea">Active</span>
                  <% } else { %>
                    <span class="chip bg-ink/10 text-ink/50"><%= ds %></span>
                  <% } %>
                </td>
                <td class="px-4 py-3">
                  <form method="post" action="/admin/access/<%= u.id %>" class="grid sm:grid-cols-2 gap-2 min-w-[260px]">
                    <input class="field" name="name" value="<%= u.name %>" />
                    <input class="field" name="phone" value="<%= u.phone %>" />
                    <input class="field" name="access_code" value="<%= u.access_code %>" />
                    <div class="flex flex-wrap gap-1.5 sm:col-span-2">
                      <button type="submit" name="_action" value="update" class="btn-ghost text-xs">Save</button>
                      <% if (waiting) { %>
                        <button type="submit" name="_action" value="unlock" class="btn-ghost text-xs text-sea border-sea/25">Unlock</button>
                      <% } else { %>
                        <button type="submit" name="_action" value="lock" class="btn-ghost text-xs text-amber border-amber/25">Lock</button>
                      <% } %>
                      <button type="submit" name="_action" value="delete" class="btn-ghost text-xs text-coral border-coral/25" onclick="return confirm('Delete this user?');">Delete</button>
                    </div>
                  </form>
                </td>
              </tr>
            <% }) %>
            <% if (!users.length) { %>
              <tr><td colspan="5" class="px-4 py-8 text-ink/45">No access users yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </main>
</body>
</html>
