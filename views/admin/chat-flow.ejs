<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · <%= businessName %></title>
  <%- include('../partials/styles') %>
</head>
<body class="font-sans text-ink page-bg min-h-screen antialiased">
  <%- include('../partials/nav') %>

  <main class="max-w-3xl mx-auto px-4 py-8 space-y-8 animate-in">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-violet mb-1">Bot replies</p>
      <h1 class="font-display text-3xl font-bold">Chat Flow</h1>
      <p class="text-ink/55 mt-1 text-sm">
        Shared access code, public form URL, and WhatsApp reply copy.
      </p>
    </div>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="rounded-2xl px-4 py-3 text-sm font-medium border <%= flash.type === 'error' ? 'bg-coral/10 text-coral border-coral/20' : 'bg-sea/10 text-sea border-sea/20' %>">
        <%= flash.message %>
      </div>
    <% } %>

    <form method="post" action="/admin/chat-flow" class="space-y-6">
      <section class="panel p-5 md:p-6 space-y-4 bg-gradient-to-br from-sea/8 via-white to-violet/8">
        <div class="flex items-center gap-2">
          <span class="chip bg-sea/15 text-sea">Access</span>
          <h2 class="font-display text-lg font-semibold">Code &amp; public link</h2>
        </div>
        <div>
          <label class="label">Common access code</label>
          <input
            class="field font-mono tracking-wider uppercase text-lg"
            name="common_access_code"
            required
            minlength="3"
            maxlength="64"
            value="<%= settings.common_access_code || 'INSU2026' %>"
            placeholder="INSU2026"
            autocomplete="off"
          />
          <p class="text-xs text-ink/45 mt-1.5">
            Shared code for <strong>every</strong> WhatsApp number — no per-user whitelist.
            Anyone who sends this exact code gets the form link and can continue the flow.
          </p>
        </div>
        <div>
          <label class="label">Public base URL (for mobile form links)</label>
          <input
            class="field font-mono text-sm"
            name="public_base_url"
            placeholder="http://YOUR_PUBLIC_IP:3000 or https://yourdomain.com"
            value="<%= settings.public_base_url || '' %>"
          />
          <p class="text-xs text-ink/45 mt-1.5">
            Leave blank to auto-detect this server’s LAN IP (not localhost).
            Use your VPS IP or domain so phones can open the form.
            Current resolved URL:
            <code class="bg-mist px-1 rounded"><%= typeof resolvedBaseUrl !== 'undefined' ? resolvedBaseUrl : '…' %></code>
          </p>
        </div>
      </section>

      <section class="panel p-5 md:p-6 space-y-4">
        <div class="flex items-center gap-2">
          <span class="chip bg-violet/15 text-violet">Messages</span>
          <h2 class="font-display text-lg font-semibold">Chat replies</h2>
        </div>
        <p class="text-sm text-ink/55">
          By default the bot shows <strong>typing…</strong>, sends a randomized natural line mixing
          <strong>English and Malayalam</strong> (with the person’s WhatsApp name when available),
          pauses, then shows typing again and sends the form URL as a
          <strong>separate clickable</strong> blue link. Leave the custom message blank to keep that behavior.
          Placeholders: <code class="text-xs bg-mist px-1 rounded">{{name}}</code>
        </p>

        <div>
          <label class="label">Custom first-line text only (optional — leave blank for bilingual random lines)</label>
          <textarea class="field font-mono text-xs" name="form_link_message" rows="2" placeholder="Okay {{name}}, please fill this:"><%= settings.form_link_message || '' %></textarea>
          <p class="text-xs text-ink/45 mt-1">Do not put the URL here — the link is always sent as the next message.</p>
        </div>
        <div>
          <label class="label">Form page intro (web form)</label>
          <textarea class="field" name="form_intro" rows="2"><%= settings.form_intro || '' %></textarea>
        </div>
        <div>
          <label class="label">Success message (after web form submit)</label>
          <textarea class="field" name="success_message" rows="3"><%= settings.success_message || '' %></textarea>
        </div>
        <div>
          <label class="label">Chat close message</label>
          <textarea class="field" name="chat_close_message" rows="2"><%= settings.chat_close_message || '' %></textarea>
        </div>
        <div>
          <label class="label">Company desk close notify</label>
          <textarea class="field" name="company_close_notify_message" rows="2"><%= settings.company_close_notify_message || '' %></textarea>
        </div>
        <div>
          <label class="label">Forward template (desk lead summary)</label>
          <textarea class="field font-mono text-xs" name="forward_template" rows="6"><%= settings.forward_template || '' %></textarea>
        </div>
      </section>

      <button type="submit" class="btn-primary px-8 py-3">Save chat flow</button>
    </form>
  </main>
</body>
</html>
