NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
# Public URL phones can open (use your VPS IP or domain — not localhost)
# Example: http://203.0.113.10:3000  or  https://leads.example.com
BASE_URL=http://localhost:3000

# Google Gemini — trigger-based plan assistant (Malayalam voice notes)
# Get a key: https://aistudio.google.com/apikey
# Flow: user sends PLAN → greeting voice note → plan Q&A (text/voice) → CLS to end
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
