NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
# Public URL phones can open (must match your Nginx domain — not localhost in production)
# Example: https://futureshield.online
BASE_URL=https://futureshield.online

# Google Gemini — trigger-based plan assistant (Malayalam voice notes)
# Get a key: https://aistudio.google.com/apikey
# Flow: user sends PLAN → greeting voice note → plan Q&A (text/voice) → CLS to end
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.0-flash
# GEMINI_PLAN_MODEL=gemini-2.5-flash
# GEMINI_PLAN_TIMEOUT_MS=60000
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
