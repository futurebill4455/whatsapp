{
  "name": "whatsapp-lead-intake",
  "version": "1.0.0",
  "description": "Secure WhatsApp automation & insurance lead intake system",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/input.css -o ./public/css/tailwind.css --minify",
    "build": "npm run build:css",
    "postinstall": "npm run build:css",
    "prestart": "node scripts/ensure-css.js",
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite --watch server.js",
    "seed": "node --experimental-sqlite src/utils/seed.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sparticuz/chromium": "^149.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "drawflow": "^0.0.60",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.2.0",
    "puppeteer-core": "^24.38.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "tailwindcss": "^3.4.17",
    "whatsapp-web.js": "^1.34.2",
    "xlsx": "^0.18.5"
  },
  "overrides": {
    "puppeteer": "$puppeteer-core"
  },
  "puppeteer": {
    "skipDownload": true
  }
}
